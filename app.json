{
  "expo": {
    "name": "Hearth & Well",
    "slug": "hearth-and-well",
    "scheme": "hearthwell",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14110F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hearthandwell",
      "infoPlist": {}
    },
    "android": {
      "package": "app.hearthandwell",
      "adaptiveIcon": {
        "backgroundColor": "#14110F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14110F"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E0A04B",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "476c5a6b-6357-455c-b7da-983880036283"
      }
    },
    "owner": "cw769844"
  }
}
